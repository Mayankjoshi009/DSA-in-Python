#Find the  2nd largest element in array.

nums=[55,32,5,6,78,88,767,665,444,-90,-89,-456]
largest = float("-inf")
second_largest = float("-inf")
n = len(nums)
for i in range(0, n):
    largest = max(largest, nums[i])
print("The largest element in the array is:", largest)    
for i in range(0, n):
    if nums[i]>second_largest and nums[i]!=largest:
        second_largest = nums[i]
print("1.The second largest element in the array is:", second_largest)


#Time Complexity: O(2n)
#Space Complexity: O(1) 


#method 2


largest = float("-inf")
second_largest = float("-inf")
for i in range(0, n):
    if nums[i]>largest:
        second_largest = largest
        largest = nums[i]
    elif nums[i]>second_largest and nums[i]!=largest:
        second_largest = nums[i]
print("2.The second largest element in the array is:", second_largest)

#Time Complexity: O(n)
#Space Complexity: O(1) 