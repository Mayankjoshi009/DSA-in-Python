#Optimum Solution

print("Optimum Solution")
num = [5, 10, 15, 20, 3, 5, 6, 7, 100, 8, 99, 44, 33, 212, 33, 55, 22, 11, 9, 8, 7, 6, 5, 4, 3, 2, 1]
num.sort()
def dup(num):
    n = len(num)
    if n == 1:
        return 1
    i = 0
    j = i+1
    while j < n :
        if num[j]!=num[i]:
            i+=1
            num[i],num[j]=num[j],num[i]
        j+=1 
    return i+1      

d = dup(num)
print("2. After removing duplicate",num[:d])