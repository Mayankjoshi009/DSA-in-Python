# Remove duplicates and sort the values.
nums = [5, 10, 15, 20, 3, 5, 6, 7, 100, 8, 99, 44, 33, 212, 33, 55, 22, 11, 9, 8, 7, 6, 5, 4, 3, 2, 1]
print("Before Sorted:",nums)
nums.sort()
print("Sorted:", nums)

fre_map = {}
for x in nums:
    fre_map[x] = 0

j = 0
for k in fre_map:
    nums[j] = k
    j += 1
del nums[j:]
print("After removing duplicates:", nums)